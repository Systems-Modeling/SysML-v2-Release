        <ownedRelatedElement xsi:type="sysml:AttributeDefinition" xmi:id="07a5b4f0-2f4c-5af6-8b97-048deb3883a9" declaredName="StandardAbsoluteActivityInSolutionValue" elementId="07a5b4f0-2f4c-5af6-8b97-048deb3883a9" isImpliedIncluded="true">
