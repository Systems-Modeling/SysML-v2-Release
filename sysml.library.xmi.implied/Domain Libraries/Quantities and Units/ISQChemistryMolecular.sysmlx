          <ownedRelationship xsi:type="sysml:Subsetting" xmi:id="036df3c6-984b-5573-b706-de3adabad814" elementId="036df3c6-984b-5573-b706-de3adabad814" subsettingFeature="9d0936ac-30a3-5e0a-a4b2-6ede8f836766">
