      </ownedRelationship>
      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="186e8092-4e64-5c5e-90d1-2b17e1096748" elementId="186e8092-4e64-5c5e-90d1-2b17e1096748">
        <ownedRelatedElement xsi:type="sysml:AttributeUsage" xmi:id="554a2328-db4e-50ad-9d7f-34ee9dd53985" declaredName="extentOfReaction" elementId="554a2328-db4e-50ad-9d7f-34ee9dd53985" isImpliedIncluded="true">
          <ownedRelationship xsi:type="sysml:FeatureTyping" xmi:id="5ee101bc-fe8d-5396-a06e-5162ec069b1d" elementId="5ee101bc-fe8d-5396-a06e-5162ec069b1d" typedFeature="554a2328-db4e-50ad-9d7f-34ee9dd53985">
            <type href="ISQBase.sysmlx#c03166da-0942-56ec-ab92-dfc3582799a0"/>
          </ownedRelationship>
          <ownedRelationship xsi:type="sysml:Subsetting" xmi:id="a1cd8869-bfcc-511e-9ae3-ae3142aa58e6" elementId="a1cd8869-bfcc-511e-9ae3-ae3142aa58e6" subsettingFeature="554a2328-db4e-50ad-9d7f-34ee9dd53985">
            <subsettedFeature href="Quantities.sysmlx#c7714593-3eaf-5b95-b1db-d8176e575f09"/>
          </ownedRelationship>
          <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="c6a94f1b-f3c1-5c61-a682-9c845ae0312e" elementId="c6a94f1b-f3c1-5c61-a682-9c845ae0312e">
            <ownedRelatedElement xsi:type="sysml:Documentation" xmi:id="17dd757a-6dad-5879-a015-72b25c440bb6" elementId="17dd757a-6dad-5879-a015-72b25c440bb6" body="source: item 9-31 extent of reaction&#xA;symbol(s): `&#x3be;`&#xA;application domain: generic&#xA;name: ExtentOfReaction (specializes AmountOfSubstance)&#xA;quantity dimension: N^1&#xA;measurement unit(s): mol&#xA;tensor order: 0&#xA;definition: difference of initial amount `n_(B &quot;in&quot;)` of substance `B` (item 9-2) and equilibrium amount `n_(B &quot;eq&quot;)` of substance `B` (item 9-2) divided by stoichiometric number `&#x3bd;_B` of substance `B` (item 9-29): `&#x3be; = (n_(B &quot;eq&quot;) - n_(B &quot;in&quot;))/&#x3bd;_B`&#xA;remarks: See remark to item 9-30.&#xA;"/>
          </ownedRelationship>
        </ownedRelatedElement>
      </ownedRelationship>
      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="7b2f399d-6804-52b0-812b-b8b9c219e1ea" elementId="7b2f399d-6804-52b0-812b-b8b9c219e1ea">
        <ownedRelatedElement xsi:type="sysml:Comment" xmi:id="5195c6c5-6a47-5209-8df9-d5516e4f4318" elementId="5195c6c5-6a47-5209-8df9-d5516e4f4318" body="ISO-80000-9 item 9-32 standard equilibrium constant, thermodynamic equilibrium constant "/>
      </ownedRelationship>
      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="2e1448cc-51dc-5b77-869e-35be2370f3b6" elementId="2e1448cc-51dc-5b77-869e-35be2370f3b6">
        <ownedRelatedElement xsi:type="sysml:AttributeDefinition" xmi:id="f5f6fc94-1cac-501e-9b5a-872a3cf9847f" declaredName="StandardEquilibriumConstantValue" elementId="f5f6fc94-1cac-501e-9b5a-872a3cf9847f" isImpliedIncluded="true">
          <ownedRelationship xsi:type="sysml:Subclassification" xmi:id="73c7ab29-4aa6-52fc-bfdf-875c07676f5c" elementId="73c7ab29-4aa6-52fc-bfdf-875c07676f5c" subclassifier="f5f6fc94-1cac-501e-9b5a-872a3cf9847f">
            <superclassifier href="MeasurementReferences.sysmlx#5479d03d-6afe-501d-87df-deaee4bfeaf5"/>
          </ownedRelationship>
          <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="c0b7a0f4-24b9-5fd1-90f3-d5138f3b3a19" elementId="c0b7a0f4-24b9-5fd1-90f3-d5138f3b3a19">
            <ownedRelatedElement xsi:type="sysml:Documentation" xmi:id="865d1741-0f55-5f5f-8798-183ff34ec1da" elementId="865d1741-0f55-5f5f-8798-183ff34ec1da" body="source: item 9-32 standard equilibrium constant, thermodynamic equilibrium constant&#xA;symbol(s): `K^!`&#xA;application domain: generic&#xA;name: StandardEquilibriumConstant (specializes DimensionOneQuantity)&#xA;quantity dimension: 1&#xA;measurement unit(s): 1&#xA;tensor order: 0&#xA;definition: for a chemical reaction, product for all substances `B` of standard absolute activity `&#x3bb;_B^!` of substance `B` (item 9-26) in power of minus stoichiometric number `&#x3bd;_B` of substance `B` (item 9-29): `K^! = prod_B (tilde(a) &#x3bb;_B^!)^(-&#x3bd;_B)`&#xA;remarks: This quantity is a function of temperature only. Others depend on temperature, pressure, and composition. One can define in an analogous way an equilibrium constant in terms of fugacity, `K_f`, molality, `K_m`, etc.&#xA;"/>
          </ownedRelationship>
