      </ownedRelationship>
      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="9bc9cc8e-c78d-588a-b8e0-ead16dd0008d" elementId="9bc9cc8e-c78d-588a-b8e0-ead16dd0008d">
