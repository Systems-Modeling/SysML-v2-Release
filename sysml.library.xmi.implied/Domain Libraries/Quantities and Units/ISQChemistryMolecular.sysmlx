      </ownedRelationship>
      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="4e99aa97-e215-5d07-bdb6-630a8e0b0e1c" elementId="4e99aa97-e215-5d07-bdb6-630a8e0b0e1c">
        <ownedRelatedElement xsi:type="sysml:AttributeDefinition" xmi:id="94b90bc4-9c3e-5f28-822b-255a6626b15b" declaredName="StandardChemicalPotentialValue" elementId="94b90bc4-9c3e-5f28-822b-255a6626b15b" isImpliedIncluded="true">
          <ownedRelationship xsi:type="sysml:Subclassification" xmi:id="b45525f5-5894-5237-ab97-ce1e6c669861" elementId="b45525f5-5894-5237-ab97-ce1e6c669861" subclassifier="94b90bc4-9c3e-5f28-822b-255a6626b15b">
