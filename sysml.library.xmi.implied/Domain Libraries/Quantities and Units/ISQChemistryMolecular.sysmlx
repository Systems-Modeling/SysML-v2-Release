      </ownedRelationship>
      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="fb5ebae6-a365-5f95-acd7-fc091d46e478" elementId="fb5ebae6-a365-5f95-acd7-fc091d46e478">
        <ownedRelatedElement xsi:type="sysml:AttributeDefinition" xmi:id="d6ff6bcc-47e8-5f85-9b09-4f0bbeddce1b" declaredName="FugacityValue" elementId="d6ff6bcc-47e8-5f85-9b09-4f0bbeddce1b" isImpliedIncluded="true">
          <ownedRelationship xsi:type="sysml:Subclassification" xmi:id="f3aac422-d71f-55a3-8d79-66ee2a60ac55" elementId="f3aac422-d71f-55a3-8d79-66ee2a60ac55" subclassifier="d6ff6bcc-47e8-5f85-9b09-4f0bbeddce1b">
            <superclassifier href="Quantities.sysmlx#0d9c5792-3f82-52c2-85e4-ae7a50796f90"/>
          </ownedRelationship>
          <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="466cd9f8-f934-5782-ba0c-638dceac65ee" elementId="466cd9f8-f934-5782-ba0c-638dceac65ee">
            <ownedRelatedElement xsi:type="sysml:Documentation" xmi:id="ee7cc739-b987-565e-8498-73fd8f604a8a" elementId="ee7cc739-b987-565e-8498-73fd8f604a8a" body="source: item 9-20 fugacity&#xA;symbol(s): `tilde(p)_X`&#xA;application domain: generic&#xA;name: Fugacity&#xA;quantity dimension: L^-1*M^1*T^-2&#xA;measurement unit(s): Pa, kg*m^-1*s^-2&#xA;tensor order: 0&#xA;definition: for substance `X`, quantity proportional to the absolute activity, `&#x3bb;_X` (item 9-18), the proportionality factor, which is a function of temperature (ISO 80000-5) only, being determined by the condition that, at constant temperature and composition, `p_X/tilde(p)_X` tends to 1 for an indefinitely dilute gas&#xA;remarks: `tilde(p)_X = &#x3bb;_X * lim_(p->0) (p_X/&#x3bb;_X)` where `p` is total pressure (ISO 80000-4). The IUPAC preferred symbol for fugacity is `f`.&#xA;"/>
          </ownedRelationship>
