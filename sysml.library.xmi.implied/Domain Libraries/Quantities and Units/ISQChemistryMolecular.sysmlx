          <ownedRelationship xsi:type="sysml:FeatureTyping" xmi:id="e1adb9ce-fc84-59f2-a3bc-c7d2e233bad7" elementId="e1adb9ce-fc84-59f2-a3bc-c7d2e233bad7" type="ebe996b8-b76f-5b4d-8be7-dab6b0aef4e3" typedFeature="845b708d-3e8e-5966-9735-00895c0cf73e"/>
