      </ownedRelationship>
      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="4da848e2-f45f-5396-b7af-b421d77bf14a" elementId="4da848e2-f45f-5396-b7af-b421d77bf14a">
        <ownedRelatedElement xsi:type="sysml:AttributeDefinition" xmi:id="b50fc1d8-7be1-5f9d-a29b-dc10bbba1f66" declaredName="ActivityCoefficientValue" elementId="b50fc1d8-7be1-5f9d-a29b-dc10bbba1f66" isImpliedIncluded="true">
