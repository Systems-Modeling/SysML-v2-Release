          <ownedRelationship xsi:type="sysml:Subclassification" xmi:id="6aec7df2-15b2-51d3-8dba-12eb79c46c11" elementId="6aec7df2-15b2-51d3-8dba-12eb79c46c11" subclassifier="9a53dc54-4e5f-5831-b28b-cb3038ed7a80">
