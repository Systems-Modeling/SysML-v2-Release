      </ownedRelationship>
      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="f9281386-382b-5c99-baaf-50d862f5dea5" elementId="f9281386-382b-5c99-baaf-50d862f5dea5">
        <ownedRelatedElement xsi:type="sysml:AttributeDefinition" xmi:id="7b58814e-4ccc-5502-9d06-778da3f055c9" declaredName="LinearAttenuationCoefficientValue" elementId="7b58814e-4ccc-5502-9d06-778da3f055c9" isImpliedIncluded="true">
          <ownedRelationship xsi:type="sysml:Subclassification" xmi:id="3d928a61-fb9f-582f-8abd-548f3b6b48e3" elementId="3d928a61-fb9f-582f-8abd-548f3b6b48e3" subclassifier="7b58814e-4ccc-5502-9d06-778da3f055c9">
