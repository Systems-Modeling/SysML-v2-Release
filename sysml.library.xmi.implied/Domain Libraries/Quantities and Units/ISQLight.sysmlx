      </ownedRelationship>
      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="55ce747a-9ce1-5cf2-9d24-51331563bda2" elementId="55ce747a-9ce1-5cf2-9d24-51331563bda2">
        <ownedRelatedElement xsi:type="sysml:AttributeDefinition" xmi:id="606f03af-542e-511d-8074-a0a7dfc164d3" declaredName="SpectralRadiantEnergyDensityInTermsOfWavelengthValue" elementId="606f03af-542e-511d-8074-a0a7dfc164d3" isImpliedIncluded="true">
          <ownedRelationship xsi:type="sysml:Subclassification" xmi:id="f2ba6e80-92e6-544f-b659-c29c6172f229" elementId="f2ba6e80-92e6-544f-b659-c29c6172f229" subclassifier="606f03af-542e-511d-8074-a0a7dfc164d3">
