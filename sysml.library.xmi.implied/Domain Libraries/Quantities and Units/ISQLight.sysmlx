      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="89cabd01-6ab1-5a8a-b2ab-32b6f91600c4" elementId="89cabd01-6ab1-5a8a-b2ab-32b6f91600c4">
        <ownedRelatedElement xsi:type="sysml:AttributeDefinition" xmi:id="048896e5-bd87-50cc-9880-da80c78f167f" declaredName="SpectralRadiantExposureValue" elementId="048896e5-bd87-50cc-9880-da80c78f167f" isImpliedIncluded="true">
          <ownedRelationship xsi:type="sysml:Subclassification" xmi:id="e21ad074-e060-590e-b33f-c39b341637c3" elementId="e21ad074-e060-590e-b33f-c39b341637c3" subclassifier="048896e5-bd87-50cc-9880-da80c78f167f">
