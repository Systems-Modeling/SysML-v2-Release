      </ownedRelationship>
      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="aa4d8b81-5bea-5117-98c9-483bf53943b8" elementId="aa4d8b81-5bea-5117-98c9-483bf53943b8">
        <ownedRelatedElement xsi:type="sysml:AttributeDefinition" xmi:id="24e2ccd1-ca07-5be2-9bd9-20aa8f8a06d7" declaredName="RadianceValue" elementId="24e2ccd1-ca07-5be2-9bd9-20aa8f8a06d7" isImpliedIncluded="true">
          <ownedRelationship xsi:type="sysml:Subclassification" xmi:id="c8ca04da-9ad7-511b-a7c0-4774bfb2108f" elementId="c8ca04da-9ad7-511b-a7c0-4774bfb2108f" subclassifier="24e2ccd1-ca07-5be2-9bd9-20aa8f8a06d7">
