      </ownedRelationship>
      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="028a0236-e19c-55fc-9d7a-89089eadc5b2" elementId="028a0236-e19c-55fc-9d7a-89089eadc5b2">
        <ownedRelatedElement xsi:type="sysml:AttributeDefinition" xmi:id="94a82a87-1fbd-5942-a03c-333b37de078a" declaredName="SpectralRadianceValue" elementId="94a82a87-1fbd-5942-a03c-333b37de078a" isImpliedIncluded="true">
          <ownedRelationship xsi:type="sysml:Subclassification" xmi:id="30dac150-486b-5984-8736-ec15668d1a0e" elementId="30dac150-486b-5984-8736-ec15668d1a0e" subclassifier="94a82a87-1fbd-5942-a03c-333b37de078a">
