      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="a7d3e03b-9f48-5df9-9149-1a5053b843fd" elementId="a7d3e03b-9f48-5df9-9149-1a5053b843fd">
        <ownedRelatedElement xsi:type="sysml:AttributeDefinition" xmi:id="401d81c2-05b7-5662-a1bd-c16b17c55311" declaredName="LuminousAbsorptanceValue" elementId="401d81c2-05b7-5662-a1bd-c16b17c55311" isImpliedIncluded="true">
          <ownedRelationship xsi:type="sysml:Subclassification" xmi:id="2eb596d2-f0ba-5331-80a0-5d6c79694c0f" elementId="2eb596d2-f0ba-5331-80a0-5d6c79694c0f" subclassifier="401d81c2-05b7-5662-a1bd-c16b17c55311">
