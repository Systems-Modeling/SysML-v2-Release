              <ownedRelationship xsi:type="sysml:FeatureTyping" xmi:id="040f3508-f62b-5494-8d59-2e281e539915" elementId="040f3508-f62b-5494-8d59-2e281e539915" typedFeature="0577c5fe-95c4-5964-b92a-dff6ac172340">
