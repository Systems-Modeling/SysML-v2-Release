      </ownedRelationship>
      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="b7aebbb3-b413-52f4-b270-4d341ef57441" elementId="b7aebbb3-b413-52f4-b270-4d341ef57441">
        <ownedRelatedElement xsi:type="sysml:AttributeDefinition" xmi:id="0731687e-65e1-579e-bb1d-cc9c65754c28" declaredName="RefractiveIndexValue" elementId="0731687e-65e1-579e-bb1d-cc9c65754c28" isImpliedIncluded="true">
          <ownedRelationship xsi:type="sysml:Subclassification" xmi:id="29a7c8bc-6f82-5dd5-81af-321676f6c8d8" elementId="29a7c8bc-6f82-5dd5-81af-321676f6c8d8" subclassifier="0731687e-65e1-579e-bb1d-cc9c65754c28">
            <superclassifier href="MeasurementReferences.sysmlx#5479d03d-6afe-501d-87df-deaee4bfeaf5"/>
          </ownedRelationship>
          <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="f22b5a3c-0e64-5011-b59f-6aa8d83d6c62" elementId="f22b5a3c-0e64-5011-b59f-6aa8d83d6c62">
            <ownedRelatedElement xsi:type="sysml:Documentation" xmi:id="970fc201-383f-5e7c-97ea-5ea25bd1bd17" elementId="970fc201-383f-5e7c-97ea-5ea25bd1bd17" body="source: item 7-1.2 refractive index&#xA;symbol(s): `n`&#xA;application domain: generic&#xA;name: RefractiveIndex (specializes DimensionOneQuantity)&#xA;quantity dimension: 1&#xA;measurement unit(s): 1&#xA;tensor order: 0&#xA;definition: quotient of speed of light in vacuum (ISO 80000-1) and speed of light in a medium (item 7-1.1)&#xA;remarks: The value of the refractive index can depend on the frequency, polarization, and direction. The refractive index is expressed by n = c_0/c, where c_()_0 is the speed of light in vacuum and c is the speed of light in the medium. For a medium with absorption, the complex refractive index n is defined by n = n + ik where k is spectral absorption index (IEC 60050-845) and i is imaginary unit. The refractivity is expressed by n -1, where n is refractive index.&#xA;"/>
          </ownedRelationship>
        </ownedRelatedElement>
      </ownedRelationship>
      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="94350520-7011-5870-8884-47716bb0a778" elementId="94350520-7011-5870-8884-47716bb0a778">
        <ownedRelatedElement xsi:type="sysml:AttributeUsage" xmi:id="1775f035-46ee-5834-a9fb-7c411bb1a908" declaredName="refractiveIndex" elementId="1775f035-46ee-5834-a9fb-7c411bb1a908" isImpliedIncluded="true">
