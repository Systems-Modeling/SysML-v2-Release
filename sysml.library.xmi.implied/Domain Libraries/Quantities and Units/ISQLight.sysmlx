          <ownedRelationship xsi:type="sysml:Subclassification" xmi:id="5c35b99b-30cf-5059-bcf5-c46f02e92752" elementId="5c35b99b-30cf-5059-bcf5-c46f02e92752" subclassifier="e764e4f6-b9c0-5105-8e73-020e85eb47f2">
