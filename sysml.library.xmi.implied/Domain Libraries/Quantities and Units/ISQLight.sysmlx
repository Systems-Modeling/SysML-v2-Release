        <ownedRelatedElement xsi:type="sysml:AttributeDefinition" xmi:id="24da5486-e442-5635-b095-016abb5c7b30" declaredName="AbsorptanceValue" elementId="24da5486-e442-5635-b095-016abb5c7b30" isImpliedIncluded="true">
          <ownedRelationship xsi:type="sysml:Subclassification" xmi:id="7bf57e01-44cd-5e04-8915-cffec4abb370" elementId="7bf57e01-44cd-5e04-8915-cffec4abb370" subclassifier="24da5486-e442-5635-b095-016abb5c7b30">
