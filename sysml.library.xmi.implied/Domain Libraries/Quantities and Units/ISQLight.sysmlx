        <ownedRelatedElement xsi:type="sysml:AttributeUsage" xmi:id="80516b05-8b5f-50ab-84d1-f4d3721e2ff1" declaredName="photonEnergy" elementId="80516b05-8b5f-50ab-84d1-f4d3721e2ff1" isImpliedIncluded="true">
          <ownedRelationship xsi:type="sysml:FeatureTyping" xmi:id="620cb3e2-6d1c-5b65-868f-108de56c25b8" elementId="620cb3e2-6d1c-5b65-868f-108de56c25b8" typedFeature="80516b05-8b5f-50ab-84d1-f4d3721e2ff1">
