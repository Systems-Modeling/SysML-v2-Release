      </ownedRelationship>
      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="8e3f621b-9992-5f69-9f9d-1c99886dbc63" elementId="8e3f621b-9992-5f69-9f9d-1c99886dbc63">
        <ownedRelatedElement xsi:type="sysml:AttributeDefinition" xmi:id="531da113-9c1b-5da3-8b00-dc7a6c27e543" declaredName="PhotonFluxValue" elementId="531da113-9c1b-5da3-8b00-dc7a6c27e543" isImpliedIncluded="true">
