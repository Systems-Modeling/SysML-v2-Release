        <ownedRelatedElement xsi:type="sysml:AttributeUsage" xmi:id="6ebbedc5-2104-5f63-94ce-91762a0dc1c6" declaredName="radiantEnergy" elementId="6ebbedc5-2104-5f63-94ce-91762a0dc1c6" isImpliedIncluded="true">
          <ownedRelationship xsi:type="sysml:FeatureTyping" xmi:id="51137232-7ff5-5df8-a16a-5d3a705a7a7f" elementId="51137232-7ff5-5df8-a16a-5d3a705a7a7f" typedFeature="6ebbedc5-2104-5f63-94ce-91762a0dc1c6">
