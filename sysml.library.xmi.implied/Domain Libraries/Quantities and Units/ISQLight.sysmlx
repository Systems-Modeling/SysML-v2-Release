        <ownedRelatedElement xsi:type="sysml:AttributeDefinition" xmi:id="5e36728a-c820-5334-9f1a-07463097411f" declaredName="SpectralRadiantEnergyValue" elementId="5e36728a-c820-5334-9f1a-07463097411f" isImpliedIncluded="true">
          <ownedRelationship xsi:type="sysml:Subclassification" xmi:id="4c7aa09e-f8f0-5347-a008-c023c0e2c5c5" elementId="4c7aa09e-f8f0-5347-a008-c023c0e2c5c5" subclassifier="5e36728a-c820-5334-9f1a-07463097411f">
