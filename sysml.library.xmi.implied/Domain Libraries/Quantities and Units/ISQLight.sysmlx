      </ownedRelationship>
      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="d884aec6-fbd8-54b8-9e18-11eb34f81f38" elementId="d884aec6-fbd8-54b8-9e18-11eb34f81f38">
        <ownedRelatedElement xsi:type="sysml:AttributeDefinition" xmi:id="dc281975-7b3b-59d9-aab4-62204d3c5e96" declaredName="PhotonIrradianceValue" elementId="dc281975-7b3b-59d9-aab4-62204d3c5e96" isImpliedIncluded="true">
          <ownedRelationship xsi:type="sysml:Subclassification" xmi:id="42afa138-ba27-5aed-ae75-368141601df7" elementId="42afa138-ba27-5aed-ae75-368141601df7" subclassifier="dc281975-7b3b-59d9-aab4-62204d3c5e96">
            <superclassifier href="Quantities.sysmlx#0d9c5792-3f82-52c2-85e4-ae7a50796f90"/>
          </ownedRelationship>
          <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="0d9c1c7c-aa5d-54c7-bfd8-c8651c3bf3ec" elementId="0d9c1c7c-aa5d-54c7-bfd8-c8651c3bf3ec">
            <ownedRelatedElement xsi:type="sysml:Documentation" xmi:id="dbb024ba-a8ba-5b5c-99a1-62d762385388" elementId="dbb024ba-a8ba-5b5c-99a1-62d762385388" body="source: item 7-23 photon irradiance&#xA;symbol(s): `E_p`, `(E)`&#xA;application domain: generic&#xA;name: PhotonIrradiance&#xA;quantity dimension: L^-2*T^-1&#xA;measurement unit(s): m^-2*s^-1&#xA;tensor order: 0&#xA;definition: density of incident photon flux with respect to area at a point on a real or imaginary surface, expressed by `E_p = (d&#x3a6;_p)/(dA)`, where `&#x3a6;_p` is photon flux (item 7-20) and `A` is the area (ISO 80000-3) on which the photon flux is incident&#xA;remarks: The corresponding radiometric quantity is &quot;irradiance&quot; (item 7-7.1). The corresponding photometric quantity is &quot;illuminance&quot; (item 7-16).&#xA;"/>
          </ownedRelationship>
