      </ownedRelationship>
      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="205cb54a-e904-5c11-bd47-4479a4d37deb" elementId="205cb54a-e904-5c11-bd47-4479a4d37deb">
