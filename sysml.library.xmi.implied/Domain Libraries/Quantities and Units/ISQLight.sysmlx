          <ownedRelationship xsi:type="sysml:Subclassification" xmi:id="8c19f0fc-2b0c-5d9c-b0f8-55e34b11a092" elementId="8c19f0fc-2b0c-5d9c-b0f8-55e34b11a092" subclassifier="67767212-7a99-5adb-b754-0ec32fc75f9e">
