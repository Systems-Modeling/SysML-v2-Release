      </ownedRelationship>
      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="04fdfb63-530a-577c-a409-5c5a1997f18a" elementId="04fdfb63-530a-577c-a409-5c5a1997f18a">
        <ownedRelatedElement xsi:type="sysml:AttributeDefinition" xmi:id="2019a798-7371-55ee-ae85-cb5b0ae8534a" declaredName="LuminousEfficacyOfRadiationValue" elementId="2019a798-7371-55ee-ae85-cb5b0ae8534a" isImpliedIncluded="true">
          <ownedRelationship xsi:type="sysml:Subclassification" xmi:id="3a769c34-8a10-51ee-a50b-8b4a41c66d8a" elementId="3a769c34-8a10-51ee-a50b-8b4a41c66d8a" subclassifier="2019a798-7371-55ee-ae85-cb5b0ae8534a">
