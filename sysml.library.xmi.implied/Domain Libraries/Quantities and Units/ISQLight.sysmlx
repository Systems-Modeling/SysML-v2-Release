      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="212a2f53-3d2d-50bf-8c41-81a0b84b38b9" elementId="212a2f53-3d2d-50bf-8c41-81a0b84b38b9">
        <ownedRelatedElement xsi:type="sysml:Comment" xmi:id="6fae1441-1363-5360-9a0f-51d120ddf9af" elementId="6fae1441-1363-5360-9a0f-51d120ddf9af" body="ISO-80000-7 item 7-12 luminous energy, quantity of light "/>
      </ownedRelationship>
      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="56df5e90-ab8d-5c42-bae4-fbcb5a4874b5" elementId="56df5e90-ab8d-5c42-bae4-fbcb5a4874b5">
        <ownedRelatedElement xsi:type="sysml:AttributeDefinition" xmi:id="3b5b30ab-00e2-5edc-bf33-1892a04f9e93" declaredName="LuminousEnergyValue" elementId="3b5b30ab-00e2-5edc-bf33-1892a04f9e93" isImpliedIncluded="true">
          <ownedRelationship xsi:type="sysml:Subclassification" xmi:id="7d99786c-a6a8-59bc-966f-7a6bfab3e1f5" elementId="7d99786c-a6a8-59bc-966f-7a6bfab3e1f5" subclassifier="3b5b30ab-00e2-5edc-bf33-1892a04f9e93">
            <superclassifier href="Quantities.sysmlx#0d9c5792-3f82-52c2-85e4-ae7a50796f90"/>
          </ownedRelationship>
          <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="67360779-1206-5193-aaff-c0975778385b" elementId="67360779-1206-5193-aaff-c0975778385b">
            <ownedRelatedElement xsi:type="sysml:Documentation" xmi:id="5a919841-00c5-5ada-9849-6f4483bc3ee7" elementId="5a919841-00c5-5ada-9849-6f4483bc3ee7" body="source: item 7-12 luminous energy, quantity of light&#xA;symbol(s): `Q_v`, `(Q)`&#xA;application domain: generic&#xA;name: LuminousEnergy&#xA;quantity dimension: T^1*J^1&#xA;measurement unit(s): lm*s, cd*sr*s&#xA;tensor order: 0&#xA;definition: energy of electromagnetic waves weighted by the spectral luminous efficiency (item 7-10.2) multiplied by maximum luminous efficacy (item 7-11.3) of a specified photometric condition&#xA;remarks: Luminous energy for photopic vision is expressed by `Q_v = K_m int_0^&#x221e; Q_(e,&#x3bb;)(&#x3bb;) V(&#x3bb;) d&#x3bb;`, where `Q_(e,&#x3bb;)(&#x3bb;)` is the spectral radiant energy (item 7-2.2) at wavelength `&#x3bb;` (ISO 80000-3), `V(&#x3bb;)` is spectral luminous efficiency (item 7-10.2), and `K_m` is maximum luminous efficacy (7-11.3). Luminous energy can be emitted, transferred or received. Luminous energy can be expressed by the time integral of the luminous flux (item 7-13), `&#x3a6;_v`, over a given duration (ISO 80000-3), `&#x394;t`: `Q_v = int_(&#x394;t) &#x3a6;_v dt` . The corresponding radiometric quantity is &quot;radiant energy&quot; (item 7-2.1). The corresponding quantity for photons is &quot;photon energy&quot; (item 7-19.2).&#xA;"/>
          </ownedRelationship>
          <ownedRelationship xsi:type="sysml:FeatureMembership" xmi:id="97484f10-ec43-5c7b-b784-a1fa0b22c430" elementId="97484f10-ec43-5c7b-b784-a1fa0b22c430">
