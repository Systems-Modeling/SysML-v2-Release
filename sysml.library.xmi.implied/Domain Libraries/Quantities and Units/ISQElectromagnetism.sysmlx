            <ownedRelatedElement xsi:type="sysml:Documentation" xmi:id="5f768013-a2f7-59cf-8de6-9dc793ca09f4" elementId="5f768013-a2f7-59cf-8de6-9dc793ca09f4" body="source: item 6-42.2 leakage factor&#xA;symbol(s): `&#x3c3;`&#xA;application domain: generic&#xA;name: LeakageFactor (specializes DimensionOneQuantity)&#xA;quantity dimension: 1&#xA;measurement unit(s): 1&#xA;tensor order: 0&#xA;definition: `&#x3c3; = 1 - k^2` where `k` is the coupling factor (item 6-42 .1)&#xA;remarks: See IEC 60050-131 , item 131-12-42.&#xA;"/>
          </ownedRelationship>
        </ownedRelatedElement>
      </ownedRelationship>
