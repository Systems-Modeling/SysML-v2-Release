      </ownedRelationship>
      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="c3e9fe9e-c293-53af-807d-0d714147e06d" elementId="c3e9fe9e-c293-53af-807d-0d714147e06d">
