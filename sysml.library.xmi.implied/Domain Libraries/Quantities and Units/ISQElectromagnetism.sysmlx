      </ownedRelationship>
      <ownedRelationship xsi:type="sysml:OwningMembership" xmi:id="7fb1b0f8-8443-5608-b4f3-cb34a377cdde" elementId="7fb1b0f8-8443-5608-b4f3-cb34a377cdde">
        <ownedRelatedElement xsi:type="sysml:AttributeDefinition" xmi:id="c9024e42-e9ce-545a-aff6-5d6066cc35d6" declaredName="PhaseDifferenceValue" elementId="c9024e42-e9ce-545a-aff6-5d6066cc35d6" isImpliedIncluded="true">
          <ownedRelationship xsi:type="sysml:Subclassification" xmi:id="2af012db-77b4-5c56-a67e-54b7a0ac919c" elementId="2af012db-77b4-5c56-a67e-54b7a0ac919c" subclassifier="c9024e42-e9ce-545a-aff6-5d6066cc35d6">
