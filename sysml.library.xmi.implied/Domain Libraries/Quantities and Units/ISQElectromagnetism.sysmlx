          <ownedRelationship xsi:type="sysml:FeatureTyping" xmi:id="373622c0-1385-5fe8-9713-a2d0a28f5297" elementId="373622c0-1385-5fe8-9713-a2d0a28f5297" type="7d592332-ecbe-58e9-9428-b0370ef77074" typedFeature="86caa519-ac89-5b9b-819c-05751388cff7"/>
