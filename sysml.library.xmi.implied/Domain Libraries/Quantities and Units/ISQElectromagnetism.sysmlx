          <ownedRelationship xsi:type="sysml:Subclassification" xmi:id="df87aa79-7a8c-5bd9-96ca-b3e10f74be24" elementId="df87aa79-7a8c-5bd9-96ca-b3e10f74be24" subclassifier="5c67f300-c135-5b59-b798-adfcbd3410bc">
            <superclassifier href="Quantities.sysmlx#0d9c5792-3f82-52c2-85e4-ae7a50796f90"/>
