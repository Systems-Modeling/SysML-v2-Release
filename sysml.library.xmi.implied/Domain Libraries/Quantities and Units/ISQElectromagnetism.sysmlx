          <ownedRelationship xsi:type="sysml:Subsetting" xmi:id="a6ca0790-8160-51b0-a609-d3e083e6a4f8" elementId="a6ca0790-8160-51b0-a609-d3e083e6a4f8" subsettingFeature="479c6bc8-3b9c-5126-a09c-5585c379aaf2">
